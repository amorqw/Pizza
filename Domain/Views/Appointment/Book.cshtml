@model Core.Dto.RepairOrder.RepairOrderDto
@{
    ViewData["Title"] = "Запись на ремонт";
    var services = ViewBag.Services as IEnumerable<Core.Models.Service>;
}

<link rel="stylesheet" href="~/css/home.css" />

<div class="appointment-container" style="max-width: 500px; margin: 40px auto; background: #fff; border-radius: 10px; box-shadow: 0 4px 16px rgba(0,0,0,0.10); padding: 32px 24px 24px 24px;">
    <h1 style="color: #ff7f00; text-align: center;">Запись на ремонт</h1>
    @if (ViewBag.Error != null)
    {
        <div class="error-message" style="color: #c00; margin-bottom: 12px;">@ViewBag.Error</div>
    }
    @if (ViewBag.Success != null)
    {
        <div class="success-message" style="color: #080; margin-bottom: 12px; font-weight: bold;">@ViewBag.Success</div>
    }
    <form asp-action="Book" method="post" class="appointment-form">
        <div class="form-group">
            <label for="DateTime">Дата и время</label>
            <input asp-for="DateTime" name="DateTime" type="datetime-local" class="form-control" required />
            <span asp-validation-for="DateTime" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label for="ServiceId">Услуга</label>
            <select asp-for="ServiceId" name="ServiceId" class="form-control" required>
                <option value="">-- Выберите услугу --</option>
                @if (services != null)
                {
                    foreach (var s in services)
                    {
                        <option value="@s.IdService.ToString()">@s.ServiceName</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label for="CarModel">Модель автомобиля</label>
            <input asp-for="CarModel" name="CarModel" type="text" class="form-control" required />
        </div>
        <div class="form-group">
            <label for="CarRegistrationNumber">Гос. номер</label>
            <input asp-for="CarRegistrationNumber" name="CarRegistrationNumber" type="text" class="form-control" 
                   minlength="8" maxlength="9" pattern="[ABEKMHOPCTYXАВЕКМНОРСТУХ]\d{3}[ABEKMHOPCTYXАВЕКМНОРСТУХ]{2}\d{2,3}"
                   title="Формат: A159AA159 (8-9 символов)" required />
            <small class="form-text text-muted">Формат: A159AA159</small>
        </div>
        <div class="form-group">
            <label for="ProblemDescription">Описание проблемы</label>
            <textarea asp-for="ProblemDescription" name="ProblemDescription" class="form-control" rows="3" placeholder="Кратко опишите неисправность..."></textarea>
        </div>
        <button type="submit" class="autoservice-btn" style="background: #ff7f00; color: #fff; font-size: 1.1rem; padding: 12px 0; border: none; border-radius: 5px; width: 100%; font-weight: bold; letter-spacing: 0.5px; cursor: pointer; transition: background 0.3s; margin-top: 8px;">Записаться</button>
    </form>
</div>

<style>
    .appointment-form .form-group {
        margin-bottom: 18px;
        text-align: left;
    }
    .appointment-form label {
        font-size: 1rem;
        color: #555;
        margin-bottom: 5px;
        display: block;
    }
    .appointment-form .form-control {
        width: 100%;
        padding: 10px 12px;
        font-size: 1rem;
        border: 1px solid #ddd;
        border-radius: 5px;
        box-sizing: border-box;
        background: #fafafa;
        transition: border 0.2s;
    }
    .appointment-form .form-control:focus {
        border: 1.5px solid #ff7f00;
        outline: none;
        background: #fff;
    }
    .error-message {
        color: #c00;
        margin-bottom: 12px;
    }
    .success-message {
        color: #080;
        margin-bottom: 12px;
        font-weight: bold;
    }
    .text-danger {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }
    .form-text {
        font-size: 0.875rem;
        color: #6c757d;
        margin-top: 0.25rem;
    }
</style>
